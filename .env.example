# Copy to the repository-root .env locally. Never commit .env.
APP_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_engagement
BUSINESS_CONFIG_DIR=./businesses

# Backend-only secrets/settings. Leave unset until configured privately.
AI_PROVIDER=gemini
AI_CHAT_ENABLED=true
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

RAG_TOP_K=4
# Leave unset until real calibration; retrieval fails explicitly while uncalibrated.
RAG_MIN_SCORE=0.5845778993697982
RAG_MAX_CHUNKS=499
# Validated corpus snapshot TTL. 0 disables reuse; query embeddings are not cached here.
RAG_SNAPSHOT_TTL_SECONDS=30
CHUNK_TOKENS=400
CHUNK_OVERLAP=60
AGENT_MAX_ROUNDS=6
AGENT_MAX_TOOL_CALLS=10
# Shared per-process provider capacity: reserved lanes, bounded waiting, no RPM/TPM guarantee.
PROVIDER_CHAT_CONCURRENCY=2
PROVIDER_BACKGROUND_CONCURRENCY=1
PROVIDER_QUEUE_LIMIT=8
PROVIDER_QUEUE_SECONDS=2
PROVIDER_GENERATION_SECONDS=45
PROVIDER_EMBEDDING_SECONDS=35
PROVIDER_GENERATION_ATTEMPT_SECONDS=20
PROVIDER_EMBEDDING_ATTEMPT_SECONDS=15
PROVIDER_ATTEMPTS=3
PROVIDER_RETRY_BASE_SECONDS=0.25
PROVIDER_RETRY_MAX_SECONDS=5
AUTOMATION_POLL_MS=2000
AUTOMATION_ENABLED=true
AUTOMATION_MAX_ATTEMPTS=3
AUTOMATION_RETRY_SECONDS=30
ENABLE_TEST_FAILURES=false
# Local simulated external ingress. Backend-only business -> distinct secret mapping.
# Empty disables it; see docs/CHANNELS.md. Never use a browser public variable.
MOCK_CHANNEL_KEYS={}

# Exact query vectors only; lifespan-local bounded reuse. 0 disables reuse.
QUERY_EMBEDDING_TTL_SECONDS=120

# Sequential worker cycle bounds, checked between jobs (per-job timeout is separate).
AUTOMATION_BATCH_JOBS=4
AUTOMATION_BATCH_MS=1000
