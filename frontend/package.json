{
  "name": "ai-engagement-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:api && npm run test:components",
    "test:api": "node ../scripts/check_frontend_api.mjs",
    "test:components": "node --import tsx --import ./tests/dom.mjs --test --test-concurrency=1 tests/*.test.tsx"
  },
  "dependencies": {
    "framer-motion": "^14.14.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/jsdom": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "31.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "@biomejs/biome": "2.6.8"
  }
}
