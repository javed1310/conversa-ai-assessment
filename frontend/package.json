{
  "name": "ai-engagement-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:api && npm run test:components",
    "test:api": "node ../scripts/check_frontend_api.mjs",
    "test:components": "node --import tsx --import ./tests/dom.mjs --test --test-concurrency=1 tests/*.test.tsx"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@next/eslint-plugin-next": "16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/jsdom": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
